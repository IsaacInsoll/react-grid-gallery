{
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "react-jsx",
    "types": ["react"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [".type-package/consumer.tsx"]
}
