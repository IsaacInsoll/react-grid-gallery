{
  "name": "@picr/react-grid-gallery",
  "version": "1.0.0",
  "description": "Justified image gallery component for modern React applications.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "workspaces": [
    "test/fixtures/react-19"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "prepack": "npm run build",
    "watch": "tsdown --watch",
    "build": "tsdown",
    "package:check": "npm run build && node scripts/check-package.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "npm run typecheck:source && npm run typecheck:test",
    "typecheck:source": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:browser": "npm run build && playwright test",
    "test:browser:update": "npm run build && playwright test --update-snapshots",
    "test:browser:container": "./scripts/run-playwright.sh",
    "test:browser:container:update": "./scripts/run-playwright.sh test:browser:update"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.0.0",
    "@types/node": "22.20.1",
    "@types/react": "^18.2.28",
    "@types/react-dom": "18.3.7",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "publint": "0.3.22",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@12.0.1+sha512.2f94fd8bf600416416a934bfc59c4991e8bff7372ef7d842784e2a8b8d48c81555ee645069ddea73625fb8e92dc261feab0188fd5dab6c22fefd46316f5f9140",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IsaacInsoll/react-grid-gallery.git"
  },
  "keywords": [
    "react-grid-gallery",
    "justified-gallery",
    "react-gallery",
    "image-grid",
    "photo-grid",
    "typescript",
    "esm",
    "react",
    "react-component",
    "image",
    "images",
    "photo",
    "photos",
    "gallery",
    "select",
    "selectable",
    "justified",
    "tags",
    "tagging",
    "EXIF",
    "image gallery",
    "photo gallery"
  ],
  "author": "Ben Howell",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/IsaacInsoll/react-grid-gallery/issues"
  },
  "homepage": "https://github.com/IsaacInsoll/react-grid-gallery#readme"
}
