{
  "name": "@picr/react-grid-gallery",
  "version": "1.1.0",
  "description": "Responsive image gallery component with justified and masonry layouts for modern React applications.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "ACKNOWLEDGEMENTS.md",
    "dist",
    "CHANGELOG.md"
  ],
  "workspaces": [
    "test/fixtures/react-18-types",
    "test/fixtures/react-19"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "prepack": "npm run build",
    "watch": "tsdown --watch",
    "build": "tsdown",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run build && storybook build",
    "storybook:preview": "npm run build-storybook && vite preview --outDir storybook-static --host 127.0.0.1 --port 6007",
    "package:check": "npm run build && node scripts/check-package.mjs",
    "security:audit": "npm run security:audit:root && npm run security:audit:consumer",
    "security:audit:root": "npm audit --audit-level=high",
    "security:audit:consumer": "npm audit --prefix test/fixtures/packed-consumer --audit-level=high",
    "release": "release-it --only-version",
    "release:dry-run": "node scripts/release-preflight.mjs",
    "release:check": "npm run format:check && npm run lint && npm run typecheck && npm run test:types && npm test && npm run test:consumer && npm run package:check && npm run build-storybook && npm run test:browser:container && npm run security:audit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "npm run typecheck:source && npm run typecheck:test",
    "typecheck:source": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "typecheck:test": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.test.json",
    "test:types": "npm run build && node scripts/check-types.mjs",
    "test:consumer": "npm run build && node scripts/check-consumer.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:browser": "npm run build-storybook && playwright test",
    "test:browser:update": "npm run build-storybook && playwright test --update-snapshots",
    "test:browser:container": "./scripts/run-playwright.sh",
    "test:browser:container:update": "./scripts/run-playwright.sh test:browser:update"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint-react/eslint-plugin": "5.18.6",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.5.10",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "release-it": "21.0.2",
    "storybook": "10.5.10",
    "tsdown": "0.22.14",
    "typescript": "6.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "yet-another-react-lightbox": "3.32.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@12.0.2+sha512.b885e890b9418fa1693544d05f53e64f9a73ec194837d4258b15fecdd692347b1dd2a517b1b0cbaf9d31cd8e92c3b70956bd2ecc72833a57b4b3098f5bfa7943",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IsaacInsoll/react-grid-gallery.git"
  },
  "keywords": [
    "react-grid-gallery",
    "justified-gallery",
    "masonry-gallery",
    "react-gallery",
    "image-grid",
    "photo-grid",
    "typescript",
    "esm",
    "react",
    "react-component",
    "image",
    "images",
    "photo",
    "photos",
    "gallery",
    "select",
    "selectable",
    "justified",
    "masonry",
    "tags",
    "tagging",
    "EXIF",
    "image gallery",
    "photo gallery"
  ],
  "author": "Ben Howell",
  "contributors": [
    {
      "name": "Isaac Insoll",
      "url": "https://github.com/IsaacInsoll"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/IsaacInsoll/react-grid-gallery/issues"
  },
  "homepage": "https://isaacinsoll.github.io/react-grid-gallery/",
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
